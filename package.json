{
  "name": "jand.ro",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "fonts:copy": "node scripts/copy-fonts.js",
    "css:build": "npm run fonts:copy && postcss src/assets/css/input.css -o src/assets/css/app.css",
    "css:watch": "postcss src/assets/css/input.css -o src/assets/css/app.css --watch",
    "build": "npm run css:build && rimraf _site && eleventy",
    "dev": "npm run fonts:copy && npm run css:build && concurrently -k -n css,11ty -c blue,magenta \"npm run css:watch\" \"eleventy --serve --port=8081\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argueta-xyz/jand.ro.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/argueta-xyz/jand.ro/issues"
  },
  "homepage": "https://github.com/argueta-xyz/jand.ro#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/chivo-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "culori": "^4.0.2",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.17"
  }
}
