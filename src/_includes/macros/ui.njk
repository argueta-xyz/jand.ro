{% macro sideNavLink(active, href, text, ariaCurrent=false) %}
    <a href="{{ href }}" class="{{ uiClasses.sidebar.navLinkBase }} {% if active %}text-secondary flex items-center gap-3{% else %}text-on-surface-variant hover:text-on-surface{% endif %}" {% if ariaCurrent %} aria-current="page" {% endif %}>
        {% if active %}
            <span class="{{ uiClasses.sidebar.navDot }}"></span>
        {% endif %}
        {{ text }}</a>
{% endmacro %}
{% macro tocLink(isFirst, indent, slug, text) %}
    <a class="{% if isFirst %}text-secondary flex items-center gap-3{% else %}text-on-surface-variant hover:text-on-surface{% endif %} {{ uiClasses.sidebar.navLinkBase }}{% if indent %} pl-4{% endif %}" href="#{{ slug }}">
        {% if isFirst %}
            <span class="{{ uiClasses.sidebar.navDot }}"></span>
        {% endif %}
        {{ text }}</a>
{% endmacro %}