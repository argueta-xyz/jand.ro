---
layout: layouts/base.njk
bodyClass: bg-background text-on-background selection:bg-secondary selection:text-on-secondary font-body
---

{% include "components/top-nav.njk" %}
<div class="{{ uiClasses.layout.pageShell }}">
    <main class="{{ uiClasses.layout.mainMax }}">
        <nav class="{{ uiClasses.album.breadcrumbNav }}" aria-label="Breadcrumb">
            <a class="{{ uiClasses.breadcrumb.link }}" href="/albums/">{{ site.ui.album.breadcrumbList }}</a>
            {% for tag in tags %}
                <span class="{{ uiClasses.breadcrumb.sep }}"></span>
                <a class="{{ uiClasses.breadcrumb.tagLink }}" href="/albums/tags/{{ tag | tagSlug }}/">{{ tag }}</a>
            {% endfor %}
        </nav>
        <h1 class="{{ uiClasses.album.pageTitle }}">{{ title }}</h1>
        {% if date %}
            <p class="{{ uiClasses.album.dateLine }}">{{ date | postDate }}</p>
        {% endif %}
        {% if content %}
            <div class="{{ uiClasses.prose.maxMb }}">{{ content | safe }}</div>
        {% endif %}
        {% if (photos | default([])) | length %}
            <script type="application/json" id="album-lightbox-series">{{ photos | lightboxSeriesJson | safe }}</script>
            <div class="{{ uiClasses.grid.albumPhotos }}">
                {% for photo in photos %}
                    <button type="button" class="{{ uiClasses.album.lightboxBtn }}" data-lightbox-index="{{ loop.index0 }}" data-lightbox="{{ photo | lightboxPayload }}">
                        <img src="{{ photo.url }}" alt="{{ photo.alt | default('') }}" class="{{ uiClasses.album.thumbImg }}" loading="lazy" width="800" height="800"/>
                    </button>
                {% endfor %}
            </div>
        {% endif %}
    </main>
    {% include "components/footer.njk" %}
</div>
{% include "components/lightbox.njk" %}