---
layout: layouts/base.njk
bodyClass: bg-background text-on-background selection:bg-secondary selection:text-on-secondary font-body
---

{% import "macros/ui.njk" as ui with context %}
{% include "components/top-nav.njk" %}
<div class="{{ uiClasses.layout.pageShell }}">
    <main class="{{ uiClasses.layout.mainMax }}">
        <div class="{{ uiClasses.layout.grid12 }}">
            <aside class="{{ uiClasses.sidebar.aside }}">
                <div class="{{ uiClasses.sidebar.sticky }}">
                    {% if toc | length %}
                        <div class="{{ uiClasses.sidebar.card }}">
                            <h4 class="{{ uiClasses.sidebar.cardTitle }}">{{ site.ui.post.tocTitle }}</h4>
                            <p class="{{ uiClasses.sidebar.cardSubtitle }}">{{ site.ui.post.tocSubtitle }}</p>
                            <nav class="{{ uiClasses.sidebar.navStack }}" aria-label="{{ site.ui.post.tocTitle }}">
                                {% for item in toc %}
                                    {{ ui.tocLink(loop.first, item.level > 2, item.slug, item.text) }}
                                {% endfor %}
                            </nav>
                        </div>
                    {% endif %}
                    <div class="{{ uiClasses.post.sidebar.metaCol }}">
                        <span class="{{ uiClasses.post.sidebar.createdLabel }}">{{ site.ui.post.created }}</span>
                        <span class="{{ uiClasses.post.sidebar.dateLine }}">{{ date | postDate }}</span>
                    </div>
                </div>
            </aside>
            <article class="{{ uiClasses.layout.contentArticle }}">
                <nav class="{{ uiClasses.post.breadcrumbNav }}" aria-label="Breadcrumb">
                    <a class="{{ uiClasses.breadcrumb.link }}" href="/posts/">{{ site.ui.post.breadcrumbList }}</a>
                    {% for tag in tags %}
                        <span class="{{ uiClasses.breadcrumb.sep }}"></span>
                        <a class="{{ uiClasses.breadcrumb.tagLink }}" href="/posts/tags/{{ tag | tagSlug }}/">{{ tag }}</a>
                    {% endfor %}
                </nav>
                {% if heroImage %}
                    <div class="{{ uiClasses.post.hero.wrap }}">
                        <img src="{{ heroImage }}" alt="" class="{{ uiClasses.post.hero.img }}" width="1600" height="900"/>
                    </div>
                {% endif %}
                <div class="prose">
                    <h1>{{ title }}</h1>
                    <div class="{{ uiClasses.post.byline.row }}">
                        <div class="{{ uiClasses.post.byline.avatarWrap }}">
                            <div class="{{ uiClasses.post.byline.avatarBox }}">
                                {% if authorAvatar %}
                                    <img alt="" class="{{ uiClasses.post.byline.avatarImg }}" src="{{ authorAvatar }}" width="40" height="40"/>
                                {% else %}
                                    <img alt="" class="{{ uiClasses.post.byline.avatarImg }}" src="{{ site.defaults.authorAvatar }}" width="40" height="40"/>
                                {% endif %}
                            </div>
                            <div class="{{ uiClasses.post.byline.textCol }}">
                                <span class="{{ uiClasses.post.byline.metaLabel }}">{{ site.ui.post.author }}</span>
                                <span class="{{ uiClasses.post.byline.authorName }}">{{ author }}</span>
                            </div>
                        </div>
                        <div class="{{ uiClasses.post.byline.divider }}"></div>
                        <div class="{{ uiClasses.post.byline.textCol }}">
                            <span class="{{ uiClasses.post.byline.metaLabel }}">{{ site.ui.post.readingTimeLabel }}</span>
                            <span class="{{ uiClasses.post.byline.readingValue }}">{{ readingTime }}</span>
                        </div>
                    </div>
                    {{ content | safe }}
                </div>
                {% set related = collections.posts | takeRelated(page.url) %}
                {% if related | length > 0 %}
                    <section class="{{ uiClasses.post.related.section }}">
                        <h3 class="{{ uiClasses.post.related.title }}">{{ site.ui.post.relatedArtifacts }}</h3>
                        <div class="{{ uiClasses.post.related.grid }}">
                            {% for p in related %}
                                <div class="{{ uiClasses.post.related.card }}">
                                    <a href="{{ p.url }}" class="{{ uiClasses.post.related.link }}">
                                        <div class="{{ uiClasses.post.related.thumb }}">
                                            <img alt="" class="{{ uiClasses.post.related.img }}" src="{{ p.data.heroImage }}" width="400" height="500"/>
                                            <div class="{{ uiClasses.post.related.overlay }}"></div>
                                        </div>
                                        <span class="{{ uiClasses.post.related.tag }}">{{ p.data.tags[0] }}</span>
                                        <h4 class="{{ uiClasses.post.related.cardTitle }}">{{ p.data.title }}</h4>
                                    </a>
                                </div>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}
            </article>
        </div>
    </main>
    {% include "components/footer.njk" %}
</div>