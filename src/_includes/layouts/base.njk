<!DOCTYPE html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>
      {% if title %}
        {{ title }} |
      {% endif %}
      {{ site.brand.titleSuffix }}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script src="/assets/js/tailwind-config.js"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,500;0,700;0,800;1,400;1,500;1,700;1,800&amp;family=Inter:wght@400;500;700&amp;family=Space+Grotesk:wght@300;500&amp;display=swap"
      rel="stylesheet"/>
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
      rel="stylesheet"/>
    <link href="/assets/css/site.css" rel="stylesheet"/>
  </head>
  <body class="min-h-dvh flex flex-col {{ bodyClass | default('font-body selection:bg-secondary selection:text-on-secondary') }}">
    {{ content | safe }}
  </body>
</html>