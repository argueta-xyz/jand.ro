---
layout: layouts/base.njk
---

{% import "macros/icon.njk" as uiIcon with context %}
{% include "components/top-nav.njk" %}
<div class="{{ uiClasses.layout.pageShell }}">
    <main class="{{ uiClasses.layout.mainHome }}">
        <div class="{{ uiClasses.home.heroStage }}">
            <header>
                <h1 class="{{ uiClasses.home.heroTitle }}">{{ site.hero_title | safe }}</h1>
                <p class="{{ uiClasses.home.heroDesc }}">{{ site.description }}</p>
            </header>
            <p class="sr-only">{{ site.ui.home.scrollHintSr }}</p>
        </div>
        <div class="{{ uiClasses.home.scrollHint }}" aria-hidden="true">
            <span class="{{ uiClasses.home.scrollHintIcon }}">{{ uiIcon.uiIcon('expand_more', 'h-9 w-9') }}</span>
        </div>
        {% set postCount = collections.posts | length %}
        {% if postCount > 0 %}
            {% set post = collections.posts[0] %}
            {% include "components/article-preview-featured.njk" %}
            {% if postCount > 1 %}
                <div class="{{ uiClasses.grid.cards }}">
                    {% for post in collections.posts %}
                        {% if loop.index0 >= 1 %}
                            {% set item = post %}
                            {% include "components/preview-card.njk" %}
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    </main>
    {% include "components/footer.njk" %}
</div>