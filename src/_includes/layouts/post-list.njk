---
layout: layouts/base.njk
bodyClass: font-body selection:bg-secondary selection:text-on-secondary bg-background text-on-background
---

{% set listSection = listSection | default('posts') %}
{% include "components/top-nav.njk" %}
<div class="{{ uiClasses.layout.pageShell }}">
    {% set activeTagSlug = tag.slug if tag else '' %}
    {% if listSection == 'albums' %}
        {% if tag %}
            {% set listAlbums = collections.albums | albumsWithTagSlug(tag.slug) %}
        {% else %}
            {% set listAlbums = collections.albums %}
        {% endif %}
    {% else %}
        {% if tag %}
            {% set listPosts = collections.posts | postsWithTagSlug(tag.slug) %}
        {% else %}
            {% set listPosts = collections.posts %}
        {% endif %}
    {% endif %}
    <main class="{{ uiClasses.layout.mainMax }}">
        <div class="{{ uiClasses.layout.grid12 }}">
            <aside class="{{ uiClasses.sidebar.aside }}">
                <div class="{{ uiClasses.sidebar.sticky }}">
                    {% include "components/post-tags-sidebar.njk" %}
                </div>
            </aside>
            <div class="{{ uiClasses.layout.contentCol }}">
                <h1 class="{{ uiClasses.postList.pageTitle }}">{{ title }}</h1>
                {% if content %}
                    <div class="{{ uiClasses.prose.maxMb }}">{{ content | safe }}</div>
                {% endif %}
                {% if listSection == 'albums' %}
                    {% if listAlbums | length %}
                        <div class="{{ uiClasses.grid.cards }}">
                            {% for album in listAlbums %}
                                {% set item = album %}
                                {% include "components/preview-card.njk" %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="{{ uiClasses.postList.emptyText }}">{{ site.ui.album.noAlbumsForTag }}</p>
                    {% endif %}
                {% else %}
                    {% if listPosts | length %}
                        <div class="{{ uiClasses.grid.cards }}">
                            {% for post in listPosts %}
                                {% set item = post %}
                                {% include "components/preview-card.njk" %}
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="{{ uiClasses.postList.emptyText }}">{{ site.ui.post.noPostsForTag }}</p>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </main>
    {% include "components/footer.njk" %}
</div>