<article class="{{ uiClasses.featured.article }}">
    <a href="{{ post.url }}" class="{{ uiClasses.featured.thumbLink }}">
        <img alt="" class="{{ uiClasses.featured.img }}" src="{{ post.data.heroImage }}"/>
        <div class="{{ uiClasses.featured.tagWrap }}">
            <span class="{{ uiClasses.featured.tagPill }}">{{ post.data.tags[0] }}</span>
        </div>
    </a>
    <div class="{{ uiClasses.featured.body }}">
        <div class="{{ uiClasses.featured.metaRow }}">
            <span>{{ post.date | postDate }}</span>
            <span class="{{ uiClasses.featured.metaDivider }}"></span>
            <span>{{ post.data.readingTime }}</span>
        </div>
        <h2 class="{{ uiClasses.featured.title }}">
            <a href="{{ post.url }}" class="{{ uiClasses.featured.titleLink }}">{{ post.data.title }}</a>
        </h2>
        <p class="{{ uiClasses.featured.excerpt }}">{{ post.data.excerpt }}</p>
    </div>
</article>