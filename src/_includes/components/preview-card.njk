{% set cover = item.data.heroImage | default('') %}
{% if not cover %}
    {% set cover = item.data | albumCoverUrl %}
{% endif %}
<article class="group">
    <a href="{{ item.url }}" class="block text-inherit no-underline">
        {% if cover %}
            <div class="aspect-[4/3] overflow-hidden bg-surface-container-low mb-6">
                <img alt="" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105 opacity-60 group-hover:opacity-100" src="{{ cover }}" loading="lazy" width="800" height="600"/>
            </div>
        {% else %}
            <div class="aspect-[4/3] bg-surface-container-low mb-6"></div>
        {% endif %}
        {% if item.data.tags and item.data.tags[0] %}
            <span class="font-label text-[9px] tracking-[0.3em] uppercase text-secondary mb-4 block">{{ item.data.tags[0] }}</span>
        {% endif %}
        <h3 class="font-headline italic text-2xl mb-4 group-hover:text-primary transition-colors duration-500">{{ item.data.title }}</h3>
        {% if item.data.excerpt %}
            <p class="font-body text-sm text-on-surface-variant/70 line-clamp-2 leading-relaxed">{{ item.data.excerpt }}</p>
        {% endif %}
        {% if item.data.readingTime or item.date %}
            <div class="mt-6 font-label text-[9px] text-outline tracking-[0.2em] uppercase">
                {% if item.data.readingTime %}
                    {{ item.data.readingTime }}
                {% else %}
                    {{ item.date | postDate }}
                {% endif %}
            </div>
        {% endif %}
    </a>
</article>