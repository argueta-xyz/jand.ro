<nav class="{{ uiClasses.topNav.bar }}">
    <div class="{{ uiClasses.topNav.inner }}">
        <a href="/" class="{{ uiClasses.topNav.home }}">{% include "components/wordmark.njk" %}</a>
        <div class="{{ uiClasses.topNav.center }}">
            <a href="/albums/" class="{{ uiClasses.topNav.primaryBase }} {% if page.url | navIsActive('albums') %}{{ uiClasses.topNav.primaryActive }}{% else %}{{ uiClasses.topNav.primaryIdle }}{% endif %}" {% if page.url | navIsActive('albums') %} aria-current="page" {% endif %}>{{ site.ui.nav.albums }}</a>
            <a href="/posts/" class="{{ uiClasses.topNav.primaryBase }} {% if page.url | navIsActive('posts') %}{{ uiClasses.topNav.primaryActive }}{% else %}{{ uiClasses.topNav.primaryIdle }}{% endif %}" {% if page.url | navIsActive('posts') %} aria-current="page" {% endif %}>{{ site.ui.nav.posts }}</a>
            {% for link in site.ui.nav.external %}
                <a href="{{ link.href }}" target="_blank" rel="noopener noreferrer" class="{{ uiClasses.topNav.external }}">{{ link.label }}</a>
            {% endfor %}
        </div>
        <div class="{{ uiClasses.topNav.actions }}">
            {% for action in site.ui.nav.actions %}
                <a href="{{ action.href }}" class="{{ uiClasses.topNav.iconLink }}" aria-label="{{ action.ariaLabel }}" {% if action.external %} target="_blank" rel="noopener noreferrer" {% endif %}>
                    <span class="material-symbols-outlined">{{ action.icon }}</span>
                </a>
            {% endfor %}
        </div>
    </div>
</nav>