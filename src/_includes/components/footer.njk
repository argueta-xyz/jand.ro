<footer class="bg-background w-full py-24 px-12 border-t border-outline-variant/10">
    <div class="flex flex-col md:flex-row justify-between items-center w-full max-w-[1440px] mx-auto opacity-80 hover:opacity-100
            transition-opacity">
        <div class="mb-12 md:mb-0 text-center md:text-left">
            <div class="text-2xl text-on-surface mb-4">{% include "components/wordmark.njk" %}</div>
            <p class="font-mono text-xs tracking-widest text-outline-variant">© {{ currentYear }}
                {{ site.name | upper }}.
            {{ site.ui.footer.rightsReserved }}</p>
        </div>
        <div class="flex flex-wrap justify-center gap-12">
            <a class="font-mono text-xs tracking-widest text-outline-variant hover:text-on-surface transition-colors" href="#">{{ site.ui.footer.privacy }}</a>
            <a
                class="font-mono text-xs tracking-widest text-outline-variant hover:text-on-surface transition-colors underline"
                href="#">{{ site.ui.footer.terms }}</a>
        </div>
    </div>
</footer>