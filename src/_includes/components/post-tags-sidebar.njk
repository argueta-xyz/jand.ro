{% import "macros/ui.njk" as ui with context %}
{% set listSection = listSection | default('posts') %}
<div class="{{ uiClasses.sidebar.card }}">
    <h4 class="{{ uiClasses.sidebar.cardTitle }}">{{ site.ui.post.tagsSidebarTitle }}</h4>
    <p class="{{ uiClasses.sidebar.cardSubtitle }}">
        {% if listSection == 'albums' %}
            {{ site.ui.album.tagsSidebarSubtitle }}
        {% else %}
            {{ site.ui.post.tagsSidebarSubtitle }}
        {% endif %}
    </p>
    <nav class="{{ uiClasses.sidebar.navStack }}" aria-label="{{ site.ui.post.tagsNavLabel }}">
        {% if listSection == 'albums' %}
            {{ ui.sideNavLink(not activeTagSlug, '/albums/', site.ui.album.allAlbums) }}
            {% for t in collections.albumTagIndex %}
                {{ ui.sideNavLink(activeTagSlug == t.slug, '/albums/tags/' ~ t.slug ~ '/', t.name, activeTagSlug == t.slug) }}
            {% endfor %}
        {% else %}
            {{ ui.sideNavLink(not activeTagSlug, '/posts/', site.ui.post.allPosts) }}
            {% for t in collections.postTagIndex %}
                {{ ui.sideNavLink(activeTagSlug == t.slug, '/posts/tags/' ~ t.slug ~ '/', t.name, activeTagSlug == t.slug) }}
            {% endfor %}
        {% endif %}
    </nav>
</div>